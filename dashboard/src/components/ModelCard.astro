---
import { MS_PER_DAY, type Model } from '../lib/data';
import Sparkline from './Sparkline.astro';

interface Variant {
  id: string;
  display_name: string;
  color: string;
}
interface SnapshotRow {
  date: string;
  variant_id: string;
  values: Record<string, number>;
}
interface Snapshot {
  model_id: string;
  display_name: string;
  category: string;
  variants: Variant[];
  series: SnapshotRow[];
}

interface Props {
  model: Model;
  snapshot: Snapshot;
}
const { model, snapshot } = Astro.props;
const base = import.meta.env.BASE_URL;

const variants: Variant[] = snapshot.variants ?? [];

const sorted = [...snapshot.series].sort((a, b) => b.date.localeCompare(a.date));
const latestDate = sorted[0]?.date;
const latestRows = sorted.filter((r) => r.date === latestDate);
const latestAvgPass = latestRows.length
  ? latestRows.reduce((s, r) => s + (r.values.pass_rate ?? 0), 0) / latestRows.length
  : null;

const weekAgo = sorted.find(
  (r) =>
    latestDate &&
    r.date < latestDate &&
    (new Date(latestDate).getTime() - new Date(r.date).getTime()) / MS_PER_DAY >= 7,
);
const weekAgoVal = weekAgo?.values.pass_rate ?? null;
const delta = latestAvgPass !== null && weekAgoVal !== null ? latestAvgPass - weekAgoVal : null;

// One sparkline per variant using throughput_tokens_per_sec (or first numeric metric)
const sparkRows = variants.map((v) => {
  const rows = snapshot.series
    .filter((r) => r.variant_id === v.id && r.values.throughput_tokens_per_sec !== undefined)
    .sort((a, b) => a.date.localeCompare(b.date))
    .slice(-30);
  return { variant: v, values: rows.map((r) => r.values.throughput_tokens_per_sec) };
});
---
<a href={`${base}models/${model.slug}/`}
   class="block rounded-lg border border-zinc-200 dark:border-zinc-800 p-4 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
  <div class="flex justify-between items-start mb-3">
    <div>
      <div class="font-semibold">{model.display_name}</div>
      <div class="text-xs text-zinc-500">{model.category}</div>
    </div>
    {latestAvgPass !== null && (
      <div class="text-right">
        <div class="font-mono text-sm">{(latestAvgPass * 100).toFixed(1)}%</div>
        {delta !== null && (
          <div class={`text-xs ${delta >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`}>
            {delta >= 0 ? '+' : ''}{(delta * 100).toFixed(1)}% / 7d
          </div>
        )}
      </div>
    )}
  </div>
  <div class="space-y-1">
    {sparkRows.map(({ variant, values }) => (
      <div class="flex items-center gap-2 text-xs">
        <span class="w-28 truncate text-zinc-600 dark:text-zinc-400">{variant.display_name}</span>
        <Sparkline values={values} color={variant.color} label={`${variant.display_name} throughput`} />
      </div>
    ))}
  </div>
</a>
