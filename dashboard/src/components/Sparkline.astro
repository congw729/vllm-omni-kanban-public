---
interface Props {
  values: number[];
  color: string;
  width?: number;
  height?: number;
  label: string;
}
const { values, color, width = 80, height = 16, label } = Astro.props;

let path = '';
let extent: { min: number; max: number } | null = null;
if (values.length >= 2) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  extent = { min, max };
  const range = max - min || 1;
  const stepX = width / (values.length - 1);
  path = values
    .map((v, i) => {
      const x = i * stepX;
      const y = height - ((v - min) / range) * height;
      return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}
---
<svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
  {extent ? (
    <path d={path} stroke={color} stroke-width="1" fill="none" stroke-linejoin="round" />
  ) : (
    <line x1="0" y1={height / 2} x2={width} y2={height / 2}
          stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" opacity="0.3" />
  )}
</svg>
