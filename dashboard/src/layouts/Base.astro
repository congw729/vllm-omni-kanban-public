---
import '../styles/global.css';
import StalenessFooter from '../components/StalenessFooter.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Daily perf trends for vLLM-Omni multimodal models.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100">
    <header class="border-b border-zinc-200 dark:border-zinc-800">
      <div class="mx-auto max-w-7xl px-4 py-4 flex justify-between items-center">
        <a href={base} class="font-semibold text-lg">vllm-omni nightly perf</a>
        <nav class="text-sm text-zinc-600 dark:text-zinc-400 flex gap-6">
          <a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={base}>Overview</a>
          <a class="hover:text-zinc-900 dark:hover:text-zinc-100" href={`${base}about/`}>About</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-7xl w-full px-4 py-8 flex-1">
      <slot />
    </main>
    <StalenessFooter />
  </body>
</html>
